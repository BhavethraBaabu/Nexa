# Copy to .env and adjust. Never commit real secrets.

# --- Backend ---
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/nexa
DATABASE_USERNAME=nexa
DATABASE_PASSWORD=nexa
TEST_DATABASE_URL=jdbc:postgresql://localhost:5432/nexa_test
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Set to "logstash" or "ecs" for structured JSON logs locally (always JSON in prod).
LOG_FORMAT=

# Access-token signing key, at least 32 bytes. Required in prod; the local profile has a dev default.
# Generate one with: openssl rand -base64 48
JWT_SECRET=
# Base URL used in password-reset and invitation links.
FRONTEND_BASE_URL=http://localhost:3000
# Send the refresh cookie over HTTPS only. Keep true in prod; the local profile defaults to false.
REFRESH_COOKIE_SECURE=true

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- AI analysis (Phase 3) ---
# Anthropic API key. Without it, analysis fails with "AI analysis isn't set up".
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. Higher is more thorough but slower and costs more.
LLM_EFFORT=medium

# --- Later phases (not used yet) ---
REDIS_URL=redis://localhost:6379
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
