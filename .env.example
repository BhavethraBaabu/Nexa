# Copy to .env and adjust. Never commit real secrets.

# --- Backend ---
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/nexa
DATABASE_USERNAME=nexa
DATABASE_PASSWORD=nexa
TEST_DATABASE_URL=jdbc:postgresql://localhost:5432/nexa_test
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Set to "logstash" or "ecs" for structured JSON logs locally (always JSON in prod).
LOG_FORMAT=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- Later phases (not used yet) ---
JWT_SECRET=
LLM_API_KEY=
REDIS_URL=redis://localhost:6379
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
